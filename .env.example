ARGUS_MVP_PROFILE=true
# Docker Compose le este arquivo ao copia-lo para .env.
# No Python direto, exporte as variaveis no terminal (nao ha dotenv automatico).
ARGUS_BACKEND_HOST=0.0.0.0
ARGUS_BACKEND_PORT=8000
ARGUS_PUBLISHED_HOST=127.0.0.1
ARGUS_PUBLISHED_PORT=8000
ARGUS_MAX_UPLOAD_BYTES=5242880
ARGUS_MAX_DECODED_PIXELS=12000000
ARGUS_DETECT_RETRY_AFTER_SECONDS=1
ARGUS_YOLO_MODEL_PATH=yolov8n.pt
ARGUS_YOLOE_MODEL_PATH=yoloe-11s-seg.pt
ARGUS_YOLO_WORLD_MODEL_PATH=yolov8s-world.pt
